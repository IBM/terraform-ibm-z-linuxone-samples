# ──────────────────────────────────────────────────────────────────────────────
# TFE Active-Active Ansible — environment variable template
#
# 1. Copy this file:    cp .env.example .env
# 2. Fill in values:    edit .env
# 3. Export variables:  set -a && source .env && set +a
#
# NEVER commit .env to source control — add it to .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── TFE Node (VM1 · RHEL · s390x) ────────────────────────────────────────────
VM1_ANSIBLE_HOST=
VM1_ANSIBLE_USER=
VM1_ANSIBLE_PASSWORD=

# ── TFE Node 2 (VM2 · RHEL · s390x) — uncomment when tfe02 is active ────────
# VM2_ANSIBLE_HOST=
# VM2_ANSIBLE_USER=
# VM2_ANSIBLE_PASSWORD=

# ── External Services Node (VM2 · RHEL · x86_64) ─────────────────────────────
SERVICE_ANSIBLE_HOST=
SERVICE_ANSIBLE_USER=
SERVICE_ANSIBLE_PASSWORD=
